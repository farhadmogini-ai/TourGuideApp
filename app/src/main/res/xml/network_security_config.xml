<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- اجازه HTTP بدون SSL برای همه آدرس‌ها (فقط برای محیط توسعه) -->
    <!-- بعداً که سرور روی HTTPS مستقر شد، این فایل را حذف کنید -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
